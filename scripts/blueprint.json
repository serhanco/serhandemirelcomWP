{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "polylang"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "activateTheme",
      "themeFolderName": "serhandemirel"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "serhandemirel-core/serhandemirel-core.php"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Serhan Demirel",
        "blogdescription": "Digital Solutions Provider",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; wp_set_current_user( 1 ); if ( function_exists( 'sdc_setup_languages' ) ) { sdc_setup_languages(); }"
    }
  ],
  "features": {
    "networking": true
  }
}
